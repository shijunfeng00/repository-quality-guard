/profiles/*
!/profiles/qg-example-profile/
!/profiles/qg-example-profile/**
/equivalence-fixtures/
.qg-work/
*.pyc
__pycache__/
.pytest_cache/
.ruff_cache/
# Canonical full-repository ZIP payloads. Keep locally for packaging; never track in Git.
/offline/wheelhouse/*.whl
/offline/node_modules.zip

# Disposable API catalog/search artifacts generated by RQG.
/docs/api-reference/

# Local repository-agent guidance and task-scoped development documents.
/AGENTS.md
/PLAN.md
/TODOLIST.md
/CHECKLIST.md
/ARCH.md

# Real-project regression evidence belongs in external checkpoints, not Git history.
/references/STRUCTURE_TOPOLOGY_BASELINE.md

# Generated local audit report; never publish in Git
修改说明.md

# Private Profile tests and fixtures live under profiles/<profile>/tests/ and are
# distributed by the private overlay; they are not part of the public Git tree.

# rqgtest local generated preprocessing cache (never distribute)
/tests/cases/.cache/

# External development planning/checkpoint artifacts: never commit or publish.
# These files live under the outer checkpoint workspace, not in this product repo.
/ARCH.md
/PLAN*.md
/PLAN*.json
/DAG*.md
/DAG*.json
/CHECKLIST*.md
/CHECKLIST*.json
/TODOLIST*.md
/TODOLIST*.json
/PROGRESS*.json
/CHECKPOINT*.json
/CURRENT-HANDOFF.md
/CURRENT.mbox
/CURRENT-OVERLAY.zip

# Local rqgtest build products (the framework itself is tracked source).
/packages/rqgtest/build/
/packages/rqgtest/dist/
/packages/rqgtest/src/*.egg-info/
