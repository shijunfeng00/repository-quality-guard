{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rqg:testunit-result:v1",
  "title": "RQG observable TestUnit result ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "passed",
    "succeeded",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "rqg.testunit.result.v1"
    },
    "passed": {
      "type": "integer",
      "minimum": 0
    },
    "succeeded": {
      "type": "boolean"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "status",
          "detail",
          "steps_executed",
          "steps"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "INVALID_TEST",
              "UNSUPPORTED",
              "INCONCLUSIVE"
            ]
          },
          "detail": {
            "type": "string"
          },
          "steps_executed": {
            "type": "integer",
            "minimum": 0
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "index",
                "method",
                "status",
                "detail"
              ],
              "properties": {
                "index": {
                  "type": "integer",
                  "minimum": 1
                },
                "method": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "PASS",
                    "FAIL",
                    "INVALID_TEST",
                    "UNSUPPORTED",
                    "INCONCLUSIVE"
                  ]
                },
                "detail": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
