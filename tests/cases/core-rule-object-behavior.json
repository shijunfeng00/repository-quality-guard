    {
      "case_id": "qg062-unprotected-zip",
      "rule": "QG062",
      "kind": "TP",
      "source": "def combine(left, right):\n    return list(zip(left, right))\n",
      "expected": [
        [
          "QG062",
          "info",
          2,
          "combine"
        ]
      ]
    },
    {
      "case_id": "qg062-strict",
      "rule": "QG062",
      "kind": "TN",
      "source": "def combine(left, right):\n    return list(zip(left, right, strict=True))\n",
      "expected": []
    },
    {
      "case_id": "qg063-silent-length-repair",
      "rule": "QG063",
      "kind": "TP",
      "source": "def combine(left, right):\n    return left[:min(len(left), len(right))]\n",
      "expected": [
        [
          "QG063",
          "warning",
          2,
          "combine"
        ]
      ]
    },
    {
      "case_id": "qg063-no-repair",
