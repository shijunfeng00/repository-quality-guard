{
  "cases": [
    {
      "case_id": "b31-cpp-gcc-compile-flags",
      "databases": {
        "build": [
          {
            "directory": "@build",
            "file": "@src/main.cpp",
            "arguments": [
              "/usr/bin/g++",
              "-DMODE=7",
              "-I",
              "@include",
              "-std=gnu++20",
              "-c",
              "@src/main.cpp",
              "-o",
              "main.o"
            ]
          }
        ]
      },
      "expected": {
        "src/main.cpp": {
          "family": "gcc",
          "compiler": "/usr/bin/g++",
          "flags": [
            "-DMODE=7",
            "-std=gnu++20"
          ],
          "prefix": [],
          "syntax_flag": "-fsyntax-only",
          "no_object_output": true,
          "no_compile_only": true
        }
      },
      "sources": [
        "src/main.cpp"
      ],
      "assert_wrapper": false
    },
    {
