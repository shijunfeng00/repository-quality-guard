    {
      "case_id": "b33-cpp-override-private",
      "sources": {
        "src/sample.cpp": "namespace app {\nclass Base {\npublic:\n    virtual void tick(int value) = 0;\n};\nclass Worker : public Base {\nprivate:\n    int count_ = 0;\n    void helper() {\n        count_++;\n    }\npublic:\n    void tick(int value) override {\n        helper();\n        if (value) {\n            count_ += value;\n        }\n    }\n    static void invoke(void (*callback)()) {\n        callback();\n    }\n};\nvoid free_helper() {}\nvoid run() {\n    Worker worker;\n    worker.tick(1);\n    auto callback = &free_helper;\n    Worker::invoke(callback);\n}\n}\n"
      },
      "cpp_paths": [
        "src/sample.cpp"
      ],
      "checks": [
        {
          "kind": "symbol",
          "selector": {
            "name": "helper"
          },
          "attr": "visibility",
          "expected": "private"
        },
        {
          "kind": "symbol",
          "selector": {
            "name": "tick",
            "owner_contains": "Worker"
          },
          "attr": "visibility",
          "expected": "public"
        },
        {
          "kind": "edge",
          "source": {
            "name": "tick",
            "owner_contains": "Worker"
          },
          "target": {
            "name": "helper"
          },
          "usage": "direct_call",
          "expected": true
        },
        {
          "kind": "edge",
          "source": {
            "name": "helper"
          },
          "target": {
            "name": "count_"
          },
          "usage": "field_access",
          "expected": true
        },
        {
          "kind": "edge",
          "source": {
            "name": "tick",
            "owner_contains": "Worker"
          },
          "target": {
            "name": "count_"
          },
          "usage": "field_access",
          "expected": true
        },
        {
          "kind": "edge",
          "source": {
            "name": "tick",
            "owner_contains": "Worker"
          },
          "target": {
            "name": "tick",
            "owner_contains": "Base"
          },
          "usage": "override",
          "expected": true
        },
        {
          "kind": "edge",
          "source": {
            "name": "Worker"
          },
          "target": {
            "name": "Base"
          },
          "usage": "inheritance",
          "expected": true
        },
        {
          "kind": "edge",
          "source": {
            "name": "run"
          },
          "target": {
            "name": "free_helper"
          },
          "usage": "callable_reference",
          "expected": true
        }
      ],
      "compile": null
    },
