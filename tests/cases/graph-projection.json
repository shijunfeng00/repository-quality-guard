      "case_id": "b31-graph-lexical-boundaries",
      "sources": {
        "other.py": "def unrelated():\n    is_valid = True\n    return is_valid\n",
        "lexical.py": "def outer(value):\n    def is_valid(item):\n        return bool(item)\n    def inner(item):\n        return is_valid(item)\n    return inner(value)\n",
        "class_scope.py": "class Worker:\n    def helper(self):\n        return 1\n    def run(self):\n        return helper()\n"
      },
      "checks": [
        {
          "kind": "edge",
          "value": [
            "lexical.outer.inner",
