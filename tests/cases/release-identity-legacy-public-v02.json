{
  "schema": "release-identity-legacy-public/v02",
  "cases": [
    {
      "case_id": "release-readme-exemptions",
      "files": {
        "README.md": "release v2.8-rc3\n",
        "README_zh.md": "release v2.8-rc3\n",
        "README_ja.md": "release v2.8-rc3\n",
        "ARCHITECTURE.md": "frozen at v2.8-rc3\n"
      },
      "expected": [
        [
          "QG205",
          "ARCHITECTURE.md"
        ],
        [
          "QG205",
          "README_ja.md"
        ]
      ],
      "observe": "codes-by-path",
      "codes": [
        "QG203",
        "QG205"
      ],
      "git": true
    },
    {
      "case_id": "release-path-critical",
      "files": {
        "tests/test_v28_rc3_graph_backend.py": "def test_graph_backend():\n    assert True\n"
      },
      "codes": [
        "QG203"
      ],
      "observe": "severity-mechanism",
      "expected": [
        [
          "QG203",
          "critical",
          "path-release-identity"
        ]
      ],
      "git": true
    },
    {
      "case_id": "release-test-data-only",
